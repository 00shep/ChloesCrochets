# Copy this file to .env (which is gitignored) and fill in your token, OR
# just export SQUARE_ACCESS_TOKEN in your shell before running the script.
#
# Use a SANDBOX token when running with --env sandbox, and a PRODUCTION
# token when running with --env production. See README.md for where to
# get these from the Square Developer Dashboard.
SQUARE_ACCESS_TOKEN=your-square-access-token-here
